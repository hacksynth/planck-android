diff --git a/mm/shmem.c b/mm/shmem.c
index 597bbc2e7..95390b72b 100644
--- a/mm/shmem.c
+++ b/mm/shmem.c
@@ -5206,6 +5206,158 @@ static const struct address_space_operations shmem_aops = {
 	.error_remove_folio = shmem_error_remove_folio,
 };
 
+#ifdef CONFIG_MEMFD_CREATE
+#include <linux/compat.h>
+
+#define ASHMEM_NAME_LEN		256
+#define ASHMEM_NOT_PURGED	0
+#define ASHMEM_IS_PINNED	1
+#define __ASHMEMIOC		0x77
+
+struct ashmem_pin {
+	__u32 offset;
+	__u32 len;
+};
+
+#define ASHMEM_SET_NAME		_IOW(__ASHMEMIOC, 1, char[ASHMEM_NAME_LEN])
+#define ASHMEM_GET_NAME		_IOR(__ASHMEMIOC, 2, char[ASHMEM_NAME_LEN])
+#define ASHMEM_SET_SIZE		_IOW(__ASHMEMIOC, 3, size_t)
+#define ASHMEM_GET_SIZE		_IO(__ASHMEMIOC, 4)
+#define ASHMEM_SET_PROT_MASK	_IOW(__ASHMEMIOC, 5, unsigned long)
+#define ASHMEM_GET_PROT_MASK	_IO(__ASHMEMIOC, 6)
+#define ASHMEM_PIN		_IOW(__ASHMEMIOC, 7, struct ashmem_pin)
+#define ASHMEM_UNPIN		_IOW(__ASHMEMIOC, 8, struct ashmem_pin)
+#define ASHMEM_GET_PIN_STATUS	_IO(__ASHMEMIOC, 9)
+#define ASHMEM_PURGE_ALL_CACHES	_IO(__ASHMEMIOC, 10)
+#define ASHMEM_GET_FILE_ID	_IOR(__ASHMEMIOC, 11, unsigned long)
+
+#ifdef CONFIG_COMPAT
+#define COMPAT_ASHMEM_SET_SIZE		_IOW(__ASHMEMIOC, 3, compat_size_t)
+#define COMPAT_ASHMEM_SET_PROT_MASK	_IOW(__ASHMEMIOC, 5, compat_ulong_t)
+#define COMPAT_ASHMEM_GET_FILE_ID	_IOR(__ASHMEMIOC, 11, compat_ulong_t)
+#endif
+
+static bool shmem_is_memfd_file(struct file *file)
+{
+	struct dentry *dentry = file->f_path.dentry;
+
+	return dentry && dentry->d_name.len >= 6 &&
+	       memcmp(dentry->d_name.name, "memfd:", 6) == 0;
+}
+
+static long shmem_memfd_ashmem_get_name(struct file *file, void __user *buf)
+{
+	char name[ASHMEM_NAME_LEN] = {};
+	const char *dname = file->f_path.dentry->d_name.name + 6;
+	ssize_t len;
+
+	len = strscpy(name, dname, sizeof(name));
+	if (len < 0)
+		len = sizeof(name) - 1;
+	if (copy_to_user(buf, name, len + 1))
+		return -EFAULT;
+	return 0;
+}
+
+static long shmem_memfd_ashmem_get_prot_mask(struct file *file)
+{
+	int seals = memfd_get_seals(file);
+	unsigned long prot = PROT_READ | PROT_WRITE | PROT_EXEC;
+
+	if (seals < 0)
+		return seals;
+	if (seals & (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE))
+		prot &= ~PROT_WRITE;
+	if ((seals & F_SEAL_EXEC) && !(file_inode(file)->i_mode & 0111))
+		prot &= ~PROT_EXEC;
+	return prot;
+}
+
+static long shmem_memfd_ashmem_set_prot_mask(struct file *file,
+					     unsigned long prot)
+{
+	int seals;
+
+	if (prot & ~(PROT_READ | PROT_WRITE | PROT_EXEC))
+		return -EINVAL;
+
+	seals = memfd_get_seals(file);
+	if (seals < 0)
+		return seals;
+
+	if (prot & PROT_WRITE) {
+		if (seals & (F_SEAL_WRITE | F_SEAL_FUTURE_WRITE))
+			return -EINVAL;
+		return 0;
+	}
+
+	return memfd_add_seals(file, F_SEAL_FUTURE_WRITE);
+}
+
+static long shmem_memfd_ashmem_ioctl(struct file *file, unsigned int cmd,
+				     unsigned long arg)
+{
+	unsigned long file_id;
+
+	if (!shmem_is_memfd_file(file))
+		return -ENOTTY;
+
+	switch (cmd) {
+	case ASHMEM_GET_NAME:
+		return shmem_memfd_ashmem_get_name(file, (void __user *)arg);
+	case ASHMEM_SET_NAME:
+	case ASHMEM_SET_SIZE:
+		return -EINVAL;
+	case ASHMEM_GET_SIZE:
+		return i_size_read(file_inode(file));
+	case ASHMEM_GET_PROT_MASK:
+		return shmem_memfd_ashmem_get_prot_mask(file);
+	case ASHMEM_SET_PROT_MASK:
+		return shmem_memfd_ashmem_set_prot_mask(file, arg);
+	case ASHMEM_PIN:
+	case ASHMEM_UNPIN:
+		return ASHMEM_NOT_PURGED;
+	case ASHMEM_GET_PIN_STATUS:
+		return ASHMEM_IS_PINNED;
+	case ASHMEM_PURGE_ALL_CACHES:
+		return 0;
+	case ASHMEM_GET_FILE_ID:
+		file_id = file_inode(file)->i_ino;
+		if (put_user(file_id, (unsigned long __user *)arg))
+			return -EFAULT;
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+#ifdef CONFIG_COMPAT
+static long shmem_memfd_ashmem_compat_ioctl(struct file *file, unsigned int cmd,
+					    unsigned long arg)
+{
+	compat_ulong_t file_id;
+
+	if (!shmem_is_memfd_file(file))
+		return -ENOTTY;
+
+	switch (cmd) {
+	case COMPAT_ASHMEM_SET_SIZE:
+		return -EINVAL;
+	case COMPAT_ASHMEM_SET_PROT_MASK:
+		return shmem_memfd_ashmem_set_prot_mask(file, arg);
+	case COMPAT_ASHMEM_GET_FILE_ID:
+		file_id = file_inode(file)->i_ino;
+		if (put_user(file_id, (compat_ulong_t __user *)compat_ptr(arg)))
+			return -EFAULT;
+		return 0;
+	default:
+		return shmem_memfd_ashmem_ioctl(file, cmd,
+						(unsigned long)compat_ptr(arg));
+	}
+}
+#endif
+#endif
+
 static const struct file_operations shmem_file_operations = {
 	.mmap_prepare	= shmem_mmap_prepare,
 	.open		= shmem_file_open,
@@ -5220,6 +5372,12 @@ static const struct file_operations shmem_file_operations = {
 	.fallocate	= shmem_fallocate,
 	.setlease	= generic_setlease,
 #endif
+#ifdef CONFIG_MEMFD_CREATE
+	.unlocked_ioctl = shmem_memfd_ashmem_ioctl,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl	= shmem_memfd_ashmem_compat_ioctl,
+#endif
+#endif
 };
 
 #ifdef CONFIG_TMPFS_POSIX_ACL

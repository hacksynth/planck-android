diff --git a/fs/fs_struct.c b/fs/fs_struct.c
index 34699f3b6..05b993b51 100644
--- a/fs/fs_struct.c
+++ b/fs/fs_struct.c
@@ -192,9 +192,13 @@ static inline void validate_fs_switch(struct fs_struct *old_fs)
 	/* @old_fs may be dangling but for comparison it's fine */
 	if (old_fs != userspace_init_fs)
 		return;
-	pr_warn("VFS: Pid 1 stopped sharing filesystem state\n");
-	set_fs_root(userspace_init_fs, &init_fs.root);
-	set_fs_pwd(userspace_init_fs, &init_fs.root);
+	/*
+	 * Android init spawns property_service threads sharing userspace_init_fs
+	 * and then calls unshare(CLONE_NEWNS) + setns() in SetupMountNamespaces().
+	 * Reverting userspace_init_fs to nullfs breaks both those sibling threads
+	 * (making /sys/fs/selinux/access ENOENT) and later kworker firmware loads.
+	 */
+	pr_warn_once("VFS: Pid 1 stopped sharing filesystem state (preserving userspace_init_fs)\n");
 }
 
 struct fs_struct *switch_fs_struct(struct fs_struct *new_fs)

+static int psblk_retry_count;
+static void psblk_retry_work_fn(struct work_struct *work);
+static DECLARE_DELAYED_WORK(psblk_retry_work, psblk_retry_work_fn);
+
+static void psblk_retry_work_fn(struct work_struct *work)
+{
+	int ret;
+
+	mutex_lock(&pstore_blk_lock);
+	if (psblk_file || pstore_device_info) {
+		mutex_unlock(&pstore_blk_lock);
+		return;
+	}
+	ret = __best_effort_init();
+	mutex_unlock(&pstore_blk_lock);
+
+	if (ret && ++psblk_retry_count < 120)
+		schedule_delayed_work(&psblk_retry_work, msecs_to_jiffies(500));
+	else if (ret)
+		pr_err("failed to attach '%s' after retries: %d\n", blkdev, ret);
+}

# AOSP provides hal_light_default access to sysfs_leds. Label the backlight
# class node so the Planck lights HAL can enumerate and write brightness.
genfscon sysfs /class/backlight u:object_r:sysfs_leds:s0
genfscon sysfs /class/rmtfs u:object_r:sysfs_rmtfs:s0
genfscon sysfs /devices/platform/97c00000.rmtfs u:object_r:sysfs_rmtfs:s0
genfscon sysfs /devices/platform/reserved-memory/97c00000.rmtfs u:object_r:sysfs_rmtfs:s0
genfscon sysfs /devices/platform/remoteproc-adsp/remoteproc u:object_r:sysfs_remoteproc:s0
genfscon sysfs /devices/platform/remoteproc-cdsp/remoteproc u:object_r:sysfs_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/4080000.remoteproc u:object_r:sysfs_remoteproc:s0
genfscon sysfs /devices/platform/soc@0/5c00000.remoteproc u:object_r:sysfs_remoteproc:s0

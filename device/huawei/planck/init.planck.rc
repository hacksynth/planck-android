import /vendor/etc/init/hw/init.planck.usb.rc
import /vendor/etc/init/init.planck.utils.rc

on fs
    mount_all /vendor/etc/fstab.planck --early

on late-fs
    mount_all /vendor/etc/fstab.planck --late

on post-fs-data
    mkdir /data/vendor 0771 root root
    mkdir /data/vendor/tmp 0770 root root
    mkdir /data/vendor/readwrite 0770 root root
    mkdir /data/vendor/readonly 0770 root root
    mkdir /data/vendor/readonly/firmware 0770 root root
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi
    setprop sys.use_memfd true

on boot
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3

on property:sys.boot_completed=1
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/top-app/cpus 0-7

